{
  "rbac-security-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/rbac_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "event-bus-audit-logger": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/event_bus_logger.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
